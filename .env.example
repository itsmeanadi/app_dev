# JerkGuard — EmailJS Configuration
# See README.md for how to get these values.

# Your EmailJS public key (Dashboard → Account → API Keys → Public Key)
EXPO_PUBLIC_EMAILJS_USER_ID=your_public_key_here

# Your EmailJS service ID (Dashboard → Email Services → Service ID)
EXPO_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS template ID (Dashboard → Email Templates → Template ID)
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
